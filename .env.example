# Telegram Bot Token (от @BotFather)
BOT_TOKEN=

# Каналы для слежки через запятую
CHANNELS=slay_awards,streaminside,BotovodX

# Разрешённые группы (chat ID через запятую) — только здесь работают команды атак/настроек
# Зазывала (/callall, /mute, /unmute, /muted) работает в ЛЮБОЙ группе
ALLOWED_GROUPS=-1004365297986

# Директория для хранения состояния (groups.json, last.json и т.д.)
# По умолчанию — текущая директория
# ATTACK_STATE_DIR=/path/to/state

# Userbot (Telethon) — нужен для сбора участников и комментариев
USERBOT_API_ID=
USERBOT_API_HASH=
USERBOT_SESSION=

# Логирование
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=3

# Groq API (для генерации комментариев)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Whitelist пользователей через запятую (пусто = все могут пользоваться)
ALLOWED_USERS=
